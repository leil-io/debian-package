[Unit]
Description=LeilFS master server daemon
After=syslog.target network-online.target network.target
PartOf=leilaft.service

[Service]
Type=forking
TimeoutSec=0
ExecStart=/usr/sbin/leil-uraft-helper start-leil-master
ExecStop=/usr/sbin/leil-uraft-helper stop-leil-master
ExecReload=/usr/sbin/leil-uraft-helper reload-leil-master
Restart=no

[Install]
WantedBy=multi-user.target
