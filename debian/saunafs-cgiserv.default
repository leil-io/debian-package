# Defaults for leil-cgiserv
# leil-cgiserver(8)
#
# This is a POSIX shell fragment
#

## user to run daemon as (default: leil)
# SAUNAFSCGISERV_USER=leil

## group to run daemon as (default: leil)
# SAUNAFSCGISERV_GROUP=leil

## local address to listen on (default: any)
# BIND_HOST=localhost

## port to listen on (default: 9425)
# BIND_PORT=9425

## local path to use as HTTP document root (default: /usr/share/leil-cgi)
# ROOT_PATH=/usr/share/leil-cgi
