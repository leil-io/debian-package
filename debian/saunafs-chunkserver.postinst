#! /bin/sh

# Ensure proper permissions on data dir and run dir.

SAUNAFS_USER="saunafs"
SAUNAFS_GROUP="saunafs"
LEIL_DATA_PATH="/var/lib/leil"

check_dirs() {
	# check that the metadata dir exists
	if [ ! -d "$LEIL_DATA_PATH" ]; then
		mkdir -p "$LEIL_DATA_PATH"
	fi
	chmod 0755 "$LEIL_DATA_PATH"
	chown -R $SAUNAFS_USER:$SAUNAFS_GROUP "$LEIL_DATA_PATH"
}

check_dirs
#DEBHELPER#

